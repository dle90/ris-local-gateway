<Window x:Class="Medisync.RisLocalGateway.ConfigApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Medisync.RisLocalGateway.ConfigApp.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="RIS Local Gateway"
        Width="1120" Height="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#1F2937" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="RIS Local Gateway"
                               Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="DICOM SCP → RIS gateway"
                               Foreground="#9CA3AF" FontSize="11" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Overview.ServiceStateText}"
                           Foreground="{Binding Overview.ServiceStateColor}"
                           Background="White" Padding="10,4"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Tab content -->
        <TabControl Margin="0" Padding="0" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB">

            <!-- ============ Tab 1: TỔNG QUAN ============ -->
            <TabItem Header="Tổng quan" FontSize="13" Padding="14,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20" DataContext="{Binding Overview}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Service control -->
                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Windows Service"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="{Binding ServiceName}"
                                           Foreground="#6B7280" FontSize="11" Margin="0,2,0,12" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="▶ Start"
                                            Command="{Binding StartServiceCommand}"
                                            IsEnabled="{Binding CanStart}"
                                            Background="#10B981" Foreground="White"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="⏹ Stop"
                                            Command="{Binding StopServiceCommand}"
                                            IsEnabled="{Binding CanStop}"
                                            Background="#EF4444" Foreground="White"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="🔄 Restart"
                                            Command="{Binding RestartServiceCommand}"
                                            IsEnabled="{Binding CanRestart}"
                                            Background="#3B82F6" Foreground="White"
                                            Style="{StaticResource ActionButtonStyle}" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="{Binding ActionMessage}"
                                           Foreground="{Binding ActionMessageColor}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- DICOM Listener -->
                        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                           Text="DICOM Listener" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="AE Title" Foreground="#6B7280" FontSize="11" />
                                    <TextBlock Text="{Binding AeTitle}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="Port" Foreground="#6B7280" FontSize="11" />
                                    <TextBlock Text="{Binding Port}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding DicomListenerText}"
                                           Foreground="{Binding DicomListenerColor}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </Border>

                        <!-- RIS Connection -->
                        <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="RIS Connection"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="URL: " Foreground="#6B7280" />
                                    <TextBlock Grid.Column="1" Text="{Binding RisUrl}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RisStatusText}"
                                               Foreground="{Binding RisStatusColor}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding RisLastChecked, StringFormat='Lần cuối: {0}'}"
                                               Foreground="#6B7280" FontSize="11" />
                                </Grid>

                                <Button Grid.Row="3" Content="Kiểm tra kết nối"
                                        Command="{Binding TestRisCommand}"
                                        HorizontalAlignment="Left"
                                        Background="#3B82F6" Foreground="White"
                                        BorderThickness="0" Padding="14,6" />
                            </Grid>
                        </Border>

                        <!-- PACS Connection (STOW) -->
                        <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="PACS Connection (STOW)"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="STOW: " Foreground="#6B7280" />
                                    <TextBlock Grid.Column="1" Text="{Binding PacsUrl}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PacsStatusText}"
                                               Foreground="{Binding PacsStatusColor}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding PacsLastChecked, StringFormat='Lần cuối: {0}'}"
                                               Foreground="#6B7280" FontSize="11" />
                                </Grid>

                                <Button Grid.Row="3" Content="Kiểm tra kết nối"
                                        Command="{Binding TestPacsCommand}"
                                        HorizontalAlignment="Left"
                                        Background="#3B82F6" Foreground="White"
                                        BorderThickness="0" Padding="14,6" />
                            </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tab 2: CẤU HÌNH (3 tab con) ============ -->
            <TabItem Header="Cấu hình" FontSize="13" Padding="14,8">
                <TabControl DataContext="{Binding Configuration}" Margin="12"
                            BorderThickness="1" BorderBrush="#E5E7EB" Background="Transparent">

                    <!-- Tab con: Kết nối RIS (launchers) -->
                    <TabItem Header="Kết nối RIS" FontSize="13" Padding="12,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                        BorderThickness="1" CornerRadius="6" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Kết nối RIS" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="URL/endpoint API và tài khoản truy cập RIS — mỗi nhóm cấu hình trong một cửa sổ riêng."
                                                   Foreground="#6B7280" FontSize="11" Margin="0,2,0,16" TextWrapping="Wrap" />

                                        <!-- Summary (read-only) -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Base URL:" Foreground="#6B7280" />
                                            <TextBlock Grid.Column="1" Text="{Binding RisBaseUrlSummary}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Tài khoản:" Foreground="#6B7280" />
                                            <TextBlock Grid.Column="1" Text="{Binding RisUsernameSummary}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <!-- Launchers -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="⚙ Cấu hình endpoint API…"
                                                    Command="{Binding OpenEndpointsCommand}"
                                                    MinWidth="220" Height="34" Padding="12,4" Margin="0,0,10,0"
                                                    ToolTip="Base URL + sub-URL của từng API RIS (đổi v1/v2/v3… không cần rebuild)" />
                                            <Button Content="🔌 Tài khoản kết nối RIS…"
                                                    Command="{Binding OpenRisAccountCommand}"
                                                    MinWidth="210" Height="34" Padding="12,4"
                                                    ToolTip="Tài khoản + mật khẩu đăng nhập RIS, có nút kiểm tra đăng nhập" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab con: Cấu hình DICOM SCP -->
                    <TabItem Header="Cấu hình DICOM SCP" FontSize="13" Padding="12,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                        BorderThickness="1" CornerRadius="6" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Cấu hình DICOM SCP"
                                                   FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="AE Title và port lắng nghe kết nối từ modality."
                                                   Foreground="#6B7280" FontSize="11" Margin="0,2,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <Label Content="AE Title" />
                                                <TextBox Text="{Binding AeTitle, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Label Content="Port" />
                                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <Label Content="Thư mục lưu DICOM (để trống = mặc định)" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding StorageDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Thư mục lưu ảnh DICOM nhận được (hàng đợi spool chờ forward). Để trống = mặc định %ProgramData%\Medisync\RisLocalGateway\spool." />
                                            <Button Grid.Column="1" Content="Chọn…"
                                                    Command="{Binding BrowseStorageDirectoryCommand}"
                                                    MinWidth="72" Margin="6,0,0,0" Padding="10,4" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,16,0,0">
                                            <Button Content="Tải lại" Command="{Binding ReloadDicomCommand}"
                                                    MinWidth="100" Height="32" Margin="0,0,8,0" Padding="12,4" />
                                            <Button Content="Lưu cấu hình DICOM" Command="{Binding SaveDicomCommand}"
                                                    Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                                                    MinWidth="180" Height="32" Padding="12,4" BorderThickness="0" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding DicomStatus}"
                                                   Foreground="{Binding DicomStatusColor}"
                                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab con: Kết nối PACS (STOW) -->
                    <TabItem Header="Kết nối PACS" FontSize="13" Padding="12,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                        BorderThickness="1" CornerRadius="6" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Kết nối PACS (STOW)"
                                                   FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="Gateway nén (nếu cần) rồi đẩy ảnh tới PACS qua STOW-RS; có spool + retry nền."
                                                   Foreground="#6B7280" FontSize="11" Margin="0,2,0,12" />

                                        <Label Content="STOW URL (qua dicomweb-proxy)" />
                                        <TextBox Text="{Binding PacsStowUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Endpoint STOW-RS của PACS (đi qua dicomweb-proxy). Môi trường local: http://localhost:8080/wado/studies" />

                                        <CheckBox Content="Nén trước khi gửi (JPEG-LS Lossless mặc định)"
                                                  IsChecked="{Binding PacsCompressionEnabled}" Margin="0,14,0,0"
                                                  ToolTip="Bật: ảnh uncompressed được nén lossless trước khi gửi (giảm băng thông + lưu trữ, không mất chẩn đoán). Ảnh đã nén giữ nguyên." />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        ToolTip="Thời gian tối đa cho MỘT lần gửi (STOW) 1 ảnh lên PACS. Quá hạn = coi là thất bại → thử lại. Ảnh lớn / mạng chậm thì tăng.">
                                                <Label Content="Timeout (giây)" />
                                                <TextBox Text="{Binding PacsTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        ToolTip="Chu kỳ quét hàng đợi (spool) để gửi ảnh đang chờ; cũng là nhịp thử lại. Giảm = gửi gần realtime hơn, nhưng thử lại dày khi PACS lỗi.">
                                                <Label Content="Quét spool (giây)" />
                                                <TextBox Text="{Binding PacsScanIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4"
                                                        ToolTip="Cap an toàn cho lỗi HẠ TẦNG tạm thời (PACS/RIS/mạng down): số vòng quét thất bại tối đa trước khi đưa vào spool/failed. Lỗi ảnh bị từ chối (vĩnh viễn) thì dead-letter ngay, không đếm theo cap này.">
                                                <Label Content="Số lần retry" />
                                                <TextBox Text="{Binding PacsMaxRetries, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6"
                                                        ToolTip="Số ảnh gửi đồng thời mỗi vòng quét. Tăng để xả backlog nhanh nếu uplink + PACS chịu được; uplink hẹp thì tăng cũng nghẽn.">
                                                <Label Content="Forward song song" />
                                                <TextBox Text="{Binding PacsMaxParallelForwards, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right" Margin="0,16,0,0">
                                            <Button Content="Tải lại" Command="{Binding ReloadPacsCommand}"
                                                    MinWidth="100" Height="32" Margin="0,0,8,0" Padding="12,4" />
                                            <Button Content="Lưu cấu hình PACS" Command="{Binding SavePacsCommand}"
                                                    Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                                                    MinWidth="180" Height="32" Padding="12,4" BorderThickness="0" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding PacsStatus}"
                                                   Foreground="{Binding PacsStatusColor}"
                                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </TabItem>

            <!-- ============ Tab 3: NHẬT KÝ ============ -->
            <TabItem Header="Nhật ký" FontSize="13" Padding="14,8">
                <DockPanel DataContext="{Binding LogViewer}">
                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top" Background="#F9FAFB"
                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}"
                                          VerticalAlignment="Center" Margin="8,0" />
                                <Button Content="Mở thư mục" Command="{Binding OpenLogFolderCommand}"
                                        Padding="10,4" MinWidth="100" Height="28" Margin="0,0,4,0" />
                                <Button Content="Reload" Command="{Binding ReloadCommand}"
                                        Padding="10,4" MinWidth="80" Height="28" Margin="0,0,4,0" />
                                <Button Content="Clear" Command="{Binding ClearCommand}"
                                        Padding="10,4" MinWidth="80" Height="28" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nguồn:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <RadioButton Content="Service" GroupName="LogSource"
                                             IsChecked="{Binding ShowServiceLog}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                <RadioButton Content="ConfigApp" GroupName="LogSource"
                                             VerticalAlignment="Center" Margin="0,0,16,0" />
                                <CheckBox Content="INF" IsChecked="{Binding ShowInfo}"
                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                <CheckBox Content="WRN" IsChecked="{Binding ShowWarning}"
                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                <CheckBox Content="ERR" IsChecked="{Binding ShowError}"
                                          VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Text="Tìm:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="200" Height="26" VerticalContentAlignment="Center"
                                         Padding="6,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- File name footer -->
                    <Border DockPanel.Dock="Bottom" Background="#F3F4F6"
                            BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,4">
                        <TextBlock Text="{Binding CurrentFileText, StringFormat='File: {0}'}"
                                   Foreground="#6B7280" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Log lines -->
                    <ListBox x:Name="LogListBox" ItemsSource="{Binding Lines}"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ============ Tab 4: DANH SÁCH STUDY ============ -->
            <TabItem Header="Danh sách study" FontSize="13" Padding="14,8">
                <DockPanel DataContext="{Binding ReceivedStudies}">
                    <!-- Toolbar: filter ngày + refresh -->
                    <Border DockPanel.Dock="Top" Background="#F9FAFB"
                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,10">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#374151"
                                       Text="Danh sách study đã gửi ảnh tới gateway (lưu local, giữ 90 ngày). Đã nhận = số ảnh nhận qua C-STORE; Đã đẩy = đẩy PACS thành công; Dead-letter = ảnh lỗi chờ đẩy lại." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ToggleButton x:Name="FromToggle" Style="{StaticResource DateFilterToggleStyle}">
                                        <TextBlock Text="{Binding FromDate, StringFormat='dd/MM/yyyy'}"
                                                   Foreground="#111827" />
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=FromToggle}"
                                           PlacementTarget="{Binding ElementName=FromToggle}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           VerticalOffset="4">
                                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                                CornerRadius="8" Padding="6">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#40000000" BlurRadius="14"
                                                                  ShadowDepth="2" Direction="270" />
                                            </Border.Effect>
                                            <Calendar x:Name="FromCalendar"
                                                      SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                                      DisplayDate="{Binding FromDate}"
                                                      Style="{StaticResource ModernCalendarStyle}"
                                                      SelectedDatesChanged="OnFromDateSelected" />
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ToggleButton x:Name="ToToggle" Style="{StaticResource DateFilterToggleStyle}">
                                        <TextBlock Text="{Binding ToDate, StringFormat='dd/MM/yyyy'}"
                                                   Foreground="#111827" />
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=ToToggle}"
                                           PlacementTarget="{Binding ElementName=ToToggle}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                           VerticalOffset="4">
                                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                                CornerRadius="8" Padding="6">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#40000000" BlurRadius="14"
                                                                  ShadowDepth="2" Direction="270" />
                                            </Border.Effect>
                                            <Calendar x:Name="ToCalendar"
                                                      SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                                      DisplayDate="{Binding ToDate}"
                                                      Style="{StaticResource ModernCalendarStyle}"
                                                      SelectedDatesChanged="OnToDateSelected" />
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Button Content="🔄 Làm mới" Command="{Binding RefreshCommand}"
                                        MinWidth="110" Height="32" Padding="12,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Footer: status -->
                    <Border DockPanel.Dock="Bottom" Background="#F3F4F6"
                            BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,6">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Danh sách study -->
                    <DataGrid ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="True" Sorting="OnStudiesSorting"
                              CanUserResizeColumns="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                              AlternatingRowBackground="#F9FAFB" BorderThickness="0"
                              FontSize="12" RowHeight="26"
                              HeadersVisibility="Column"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <!-- Tay kéo resize (gripper) ở mép cột — vô hình, con trỏ đổi thành mũi tên ngang -->
                            <Style x:Key="ColumnGripperStyle" TargetType="Thumb">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="SizeWE" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F3F4F6" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Grid>
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="#E5E7EB" BorderThickness="0,0,1,1"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <!-- Vùng mũi tên chiếm chỗ cố định để SizeToHeader chừa sẵn, không bị cắt khi sort -->
                                                            <ColumnDefinition Width="16" />
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                        <!-- Mũi tên cột đang sort: ▲ tăng dần, ▼ giảm dần -->
                                                        <TextBlock x:Name="SortArrow" Grid.Column="1"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontSize="10" Foreground="#2563EB"
                                                                   Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <!-- Grippers: DataGrid tự nối dây resize theo tên PART_*HeaderGripper -->
                                                <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                                       Style="{StaticResource ColumnGripperStyle}" />
                                                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                                       Style="{StaticResource ColumnGripperStyle}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="SortDirection" Value="Ascending">
                                                    <Setter TargetName="SortArrow" Property="Text" Value="▲" />
                                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Descending">
                                                    <Setter TargetName="SortArrow" Property="Text" Value="▼" />
                                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E5E7EB" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- Ngày nhận: hiển thị dd/MM/yyyy HH:mm:ss nhưng SORT theo UTC ISO (đúng thứ tự thời gian) -->
                            <DataGridTextColumn Header="Ngày nhận" Binding="{Binding FirstReceivedText}"
                                                SortMemberPath="FirstReceivedUtc" Width="150" />
                            <DataGridTextColumn Header="Accession" Binding="{Binding AccessionNumber}" Width="105" />
                            <!-- Study UID dài: hiện gọn + tooltip full khi hover -->
                            <DataGridTextColumn Header="Study UID" Binding="{Binding StudyUid}" Width="210">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas, Courier New" />
                                        <Setter Property="Foreground" Value="#6B7280" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding StudyUid}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="AE máy chụp" Binding="{Binding CallingAe}" Width="115" />
                            <DataGridTextColumn Header="Modality" Binding="{Binding Modality}" Width="SizeToHeader" />
                            <DataGridTextColumn Header="Mã BN" Binding="{Binding PatientId}" Width="95" />
                            <DataGridTextColumn Header="Tên BN" Binding="{Binding PatientName}" Width="150" />
                            <!-- Mô tả co giãn lấp phần rộng còn lại -->
                            <DataGridTextColumn Header="Mô tả" Binding="{Binding StudyDescription}" Width="*" MinWidth="160" />
                            <!-- 3 cột đếm: co đúng bằng tên cột (SizeToHeader), số căn phải -->
                            <DataGridTextColumn Header="Đã nhận" Binding="{Binding ReceivedCount}" Width="SizeToHeader">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Đã đẩy PACS" Binding="{Binding PushedCount}" Width="SizeToHeader">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- Thất bại: =0 xanh lá đậm, >0 đỏ đậm -->
                            <DataGridTextColumn Header="Thất bại" Binding="{Binding FailedCount}" Width="SizeToHeader">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="#C62828" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FailedCount}" Value="0">
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ Tab 5: ĐẨY LẠI ẢNH LỖI (DEAD-LETTER) ============ -->
            <TabItem Header="Đẩy lại ảnh lỗi" FontSize="13" Padding="14,8">
                <DockPanel DataContext="{Binding DeadLetter}">
                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top" Background="#F9FAFB"
                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,10">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="#374151"
                                       Text="Đẩy lại (re-drive) các ảnh DICOM đã vào dead-letter lên PACS. Đẩy tuần tự từng ảnh; nếu 10 ảnh lỗi liên tiếp sẽ tự dừng (PACS/mạng có thể đang lỗi). Ảnh đẩy thành công được xoá khỏi dead-letter." />
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding FailedCount, StringFormat='Tổng: {0} file'}"
                                           FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔄 Làm mới" Command="{Binding RefreshCommand}"
                                            MinWidth="110" Height="32" Padding="12,4" Margin="0,0,8,0" />
                                    <Button Content="▶ Đẩy lại tất cả" Command="{Binding RedriveAllCommand}"
                                            IsEnabled="{Binding CanRedrive}"
                                            Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                                            MinWidth="160" Height="32" Padding="12,4" BorderThickness="0" Margin="0,0,8,0" />
                                    <Button Content="✕ Hủy" Command="{Binding CancelCommand}"
                                            IsEnabled="{Binding IsRunning}"
                                            MinWidth="80" Height="32" Padding="12,4" Margin="0,0,8,0" />
                                    <Button Content="📂 Mở thư mục dead-letter" Command="{Binding OpenFailedFolderCommand}"
                                            MinWidth="190" Height="32" Padding="12,4" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Footer: progress + bộ đếm + status -->
                    <Border DockPanel.Dock="Bottom" Background="#F3F4F6"
                            BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel>
                            <ProgressBar Height="18" Minimum="0"
                                         Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding TotalToPush, StringFormat='Cần đẩy: {0}'}"
                                           FontWeight="SemiBold" Margin="0,0,20,0" />
                                <TextBlock Text="{Binding SuccessCount, StringFormat='Thành công: {0}'}"
                                           FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,20,0" />
                                <TextBlock Text="{Binding FailCount, StringFormat='Lỗi: {0}'}"
                                           FontWeight="SemiBold" Foreground="#C62828" Margin="0,0,20,0" />
                                <TextBlock Text="{Binding CurrentFileName}" Foreground="#6B7280"
                                           FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding FailedDirPath, StringFormat='Thư mục: {0}'}"
                                       Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Danh sách tên file dead-letter (1 cột, có header) -->
                    <ListView ItemsSource="{Binding FailedFiles}" BorderThickness="0"
                              FontSize="12" AlternationCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tên file" Width="800">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas, Courier New" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="6,3" />
                                <Style.Triggers>
                                    <!-- Kẻ sọc xen kẽ cho dễ đọc -->
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F9FAFB" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- ============ Tab 6: THÔNG TIN ============ -->
            <TabItem Header="Thông tin" FontSize="13" Padding="14,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20" DataContext="{Binding About}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding ProductName}"
                                   FontSize="20" FontWeight="Bold" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Version, StringFormat='Phiên bản {0}'}"
                                   Foreground="#6B7280" Margin="0,2,0,2" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding Company}"
                                   Foreground="#6B7280" Margin="0,0,0,16" />

                        <Label Grid.Row="3" Content="Đường dẫn cấu hình" />
                        <TextBox Grid.Row="4" Text="{Binding ConfigPath, Mode=OneWay}"
                                 IsReadOnly="True" Background="#F9FAFB" />

                        <Label Grid.Row="5" Content="Đường dẫn log" />
                        <TextBox Grid.Row="6" Text="{Binding LogsPath, Mode=OneWay}"
                                 IsReadOnly="True" Background="#F9FAFB" />

                        <Label Grid.Row="7" Content="Hệ điều hành" />
                        <TextBox Grid.Row="8" Text="{Binding OsVersion, Mode=OneWay}"
                                 IsReadOnly="True" Background="#F9FAFB" />

                        <Label Grid.Row="9" Content=".NET runtime" />
                        <TextBox Grid.Row="10" Text="{Binding DotnetVersion, Mode=OneWay}"
                                 IsReadOnly="True" Background="#F9FAFB" />

                        <StackPanel Grid.Row="11" Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="📂 Mở thư mục cấu hình"
                                    Command="{Binding OpenConfigFolderCommand}"
                                    MinWidth="200" Height="32" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="📦 Xuất diagnostics .zip"
                                    Command="{Binding ExportDiagnosticBundleCommand}"
                                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                                    MinWidth="220" Height="32" Padding="12,4" BorderThickness="0" />
                        </StackPanel>

                        <TextBlock Grid.Row="12" Text="{Binding ExportMessage}"
                                   Foreground="{Binding ExportMessageColor}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
