<Window x:Class="Medisync.RisLocalGateway.ConfigApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Medisync.RisLocalGateway.ConfigApp.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="RIS Local Gateway"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#1F2937" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="RIS Local Gateway"
                               Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="DICOM SCP → RIS gateway"
                               Foreground="#9CA3AF" FontSize="11" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Overview.ServiceStateText}"
                           Foreground="{Binding Overview.ServiceStateColor}"
                           Background="White" Padding="10,4"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Tab content -->
        <TabControl Margin="0" Padding="0" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB">

            <!-- ============ Tab 1: TỔNG QUAN ============ -->
            <TabItem Header="Tổng quan" FontSize="13" Padding="14,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20" DataContext="{Binding Overview}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Service control -->
                        <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Windows Service"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="{Binding ServiceName}"
                                           Foreground="#6B7280" FontSize="11" Margin="0,2,0,12" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="▶ Start"
                                            Command="{Binding StartServiceCommand}"
                                            IsEnabled="{Binding CanStart}"
                                            Background="#10B981" Foreground="White"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="⏹ Stop"
                                            Command="{Binding StopServiceCommand}"
                                            IsEnabled="{Binding CanStop}"
                                            Background="#EF4444" Foreground="White"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="🔄 Restart"
                                            Command="{Binding RestartServiceCommand}"
                                            IsEnabled="{Binding CanRestart}"
                                            Background="#3B82F6" Foreground="White"
                                            Style="{StaticResource ActionButtonStyle}" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="{Binding ActionMessage}"
                                           Foreground="{Binding ActionMessageColor}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- DICOM Listener -->
                        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                           Text="DICOM Listener" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="AE Title" Foreground="#6B7280" FontSize="11" />
                                    <TextBlock Text="{Binding AeTitle}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="Port" Foreground="#6B7280" FontSize="11" />
                                    <TextBlock Text="{Binding Port}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{Binding DicomListenerText}"
                                           Foreground="{Binding DicomListenerColor}"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </Border>

                        <!-- RIS Connection -->
                        <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="RIS Connection"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="URL: " Foreground="#6B7280" />
                                    <TextBlock Grid.Column="1" Text="{Binding RisUrl}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RisStatusText}"
                                               Foreground="{Binding RisStatusColor}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding RisLastChecked, StringFormat='Lần cuối: {0}'}"
                                               Foreground="#6B7280" FontSize="11" />
                                </Grid>

                                <Button Grid.Row="3" Content="Kiểm tra kết nối"
                                        Command="{Binding TestRisCommand}"
                                        HorizontalAlignment="Left"
                                        Background="#3B82F6" Foreground="White"
                                        BorderThickness="0" Padding="14,6" />
                            </Grid>
                        </Border>

                        <!-- PACS Connection (STOW) -->
                        <Border Grid.Row="3" Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="PACS Connection (STOW)"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="STOW: " Foreground="#6B7280" />
                                    <TextBlock Grid.Column="1" Text="{Binding PacsUrl}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PacsStatusText}"
                                               Foreground="{Binding PacsStatusColor}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding PacsLastChecked, StringFormat='Lần cuối: {0}'}"
                                               Foreground="#6B7280" FontSize="11" />
                                </Grid>

                                <Button Grid.Row="3" Content="Kiểm tra kết nối"
                                        Command="{Binding TestPacsCommand}"
                                        HorizontalAlignment="Left"
                                        Background="#3B82F6" Foreground="White"
                                        BorderThickness="0" Padding="14,6" />
                            </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tab 2: CẤU HÌNH ============ -->
            <TabItem Header="Cấu hình" FontSize="13" Padding="14,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" DataContext="{Binding Configuration}">

                        <!-- =========== Card 1: Kết nối RIS =========== -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Kết nối RIS"
                                           FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="URL và tài khoản truy cập RIS từ gateway."
                                           Foreground="#6B7280" FontSize="11" Margin="0,2,0,12" />

                                <Label Content="Base URL" />
                                <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                                <Label Content="Tài khoản" />
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                                <Label Content="Mật khẩu" />
                                <PasswordBox x:Name="PasswordBoxControl"
                                             PasswordChanged="PasswordBoxControl_OnPasswordChanged" />

                                <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button Content="⚙ Cấu hình endpoint API…"
                                                    Command="{Binding OpenEndpointsCommand}"
                                                    MinWidth="200" Height="32" Padding="12,4" Margin="0,0,8,0"
                                                    ToolTip="Cấu hình sub-URL cho từng API của RIS (cho phép đổi v1/v2/v3…)" />
                                            <Button Content="🔑 Kiểm tra tài khoản"
                                                    Command="{Binding TestSignInCommand}"
                                                    MinWidth="170" Height="32" Padding="12,4"
                                                    ToolTip="Login thử với Base URL + endpoint SignIn + tài khoản + mật khẩu đang nhập trong form" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Tải lại" Command="{Binding ReloadRisCommand}"
                                                    MinWidth="100" Height="32" Margin="0,0,8,0" Padding="12,4" />
                                            <Button Content="Lưu kết nối RIS" Command="{Binding SaveRisCommand}"
                                                    Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                                                    MinWidth="160" Height="32" Padding="12,4" BorderThickness="0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBlock Text="{Binding RisStatus}"
                                           Foreground="{Binding RisStatusColor}"
                                           Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- =========== Card 2: Cấu hình DICOM SCP =========== -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Cấu hình DICOM SCP"
                                           FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="AE Title và port lắng nghe kết nối từ modality."
                                           Foreground="#6B7280" FontSize="11" Margin="0,2,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <Label Content="AE Title" />
                                        <TextBox Text="{Binding AeTitle, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="Port" />
                                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Label Content="Thư mục lưu DICOM (để trống = mặc định)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding StorageDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Thư mục lưu ảnh DICOM nhận được (hàng đợi spool chờ forward). Để trống = mặc định %ProgramData%\Medisync\RisLocalGateway\spool." />
                                    <Button Grid.Column="1" Content="Chọn…"
                                            Command="{Binding BrowseStorageDirectoryCommand}"
                                            MinWidth="72" Margin="6,0,0,0" Padding="10,4" />
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <Button Content="Tải lại" Command="{Binding ReloadDicomCommand}"
                                            MinWidth="100" Height="32" Margin="0,0,8,0" Padding="12,4" />
                                    <Button Content="Lưu cấu hình DICOM" Command="{Binding SaveDicomCommand}"
                                            Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                                            MinWidth="180" Height="32" Padding="12,4" BorderThickness="0" />
                                </StackPanel>

                                <TextBlock Text="{Binding DicomStatus}"
                                           Foreground="{Binding DicomStatusColor}"
                                           Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- =========== Card 3: Kết nối PACS (STOW) =========== -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Kết nối PACS (STOW)"
                                           FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Gateway nén (nếu cần) rồi đẩy ảnh tới PACS qua STOW-RS; có spool + retry nền."
                                           Foreground="#6B7280" FontSize="11" Margin="0,2,0,12" />

                                <Label Content="STOW URL (qua dicomweb-proxy)" />
                                <TextBox Text="{Binding PacsStowUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Endpoint STOW-RS của PACS (đi qua dicomweb-proxy). Môi trường local: http://localhost:8080/wado/studies" />

                                <CheckBox Content="Nén trước khi gửi (JPEG 2000 Lossless)"
                                          IsChecked="{Binding PacsCompressionEnabled}" Margin="0,14,0,0"
                                          ToolTip="Bật: ảnh uncompressed được nén JPEG 2000 Lossless trước khi gửi (giảm băng thông + lưu trữ, không mất chẩn đoán). Ảnh đã nén giữ nguyên." />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                ToolTip="Thời gian tối đa cho MỘT lần gửi (STOW) 1 ảnh lên PACS. Quá hạn = coi là thất bại → thử lại. Ảnh lớn / mạng chậm thì tăng.">
                                        <Label Content="Timeout (giây)" />
                                        <TextBox Text="{Binding PacsTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                ToolTip="Chu kỳ quét hàng đợi (spool) để gửi ảnh đang chờ; cũng là nhịp thử lại. Giảm = gửi gần realtime hơn, nhưng thử lại dày khi PACS lỗi.">
                                        <Label Content="Quét spool (giây)" />
                                        <TextBox Text="{Binding PacsScanIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4"
                                                ToolTip="Số lần gửi thất bại tối đa cho 1 ảnh trước khi đưa vào spool/failed (KHÔNG mất ảnh). Cửa sổ chịu lỗi ≈ Số lần retry × Quét spool.">
                                        <Label Content="Số lần retry" />
                                        <TextBox Text="{Binding PacsMaxRetries, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6"
                                                ToolTip="Số ảnh gửi đồng thời mỗi vòng quét. Tăng để xả backlog nhanh nếu uplink + PACS chịu được; uplink hẹp thì tăng cũng nghẽn.">
                                        <Label Content="Forward song song" />
                                        <TextBox Text="{Binding PacsMaxParallelForwards, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <Button Content="Tải lại" Command="{Binding ReloadPacsCommand}"
                                            MinWidth="100" Height="32" Margin="0,0,8,0" Padding="12,4" />
                                    <Button Content="Lưu cấu hình PACS" Command="{Binding SavePacsCommand}"
                                            Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                                            MinWidth="180" Height="32" Padding="12,4" BorderThickness="0" />
                                </StackPanel>

                                <TextBlock Text="{Binding PacsStatus}"
                                           Foreground="{Binding PacsStatusColor}"
                                           Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tab 3: NHẬT KÝ ============ -->
            <TabItem Header="Nhật ký" FontSize="13" Padding="14,8">
                <DockPanel DataContext="{Binding LogViewer}">
                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top" Background="#F9FAFB"
                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}"
                                          VerticalAlignment="Center" Margin="8,0" />
                                <Button Content="Mở thư mục" Command="{Binding OpenLogFolderCommand}"
                                        Padding="10,4" MinWidth="100" Height="28" Margin="0,0,4,0" />
                                <Button Content="Reload" Command="{Binding ReloadCommand}"
                                        Padding="10,4" MinWidth="80" Height="28" Margin="0,0,4,0" />
                                <Button Content="Clear" Command="{Binding ClearCommand}"
                                        Padding="10,4" MinWidth="80" Height="28" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="INF" IsChecked="{Binding ShowInfo}"
                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                <CheckBox Content="WRN" IsChecked="{Binding ShowWarning}"
                                          VerticalAlignment="Center" Margin="0,0,8,0" />
                                <CheckBox Content="ERR" IsChecked="{Binding ShowError}"
                                          VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Text="Tìm:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="200" Height="26" VerticalContentAlignment="Center"
                                         Padding="6,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- File name footer -->
                    <Border DockPanel.Dock="Bottom" Background="#F3F4F6"
                            BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12,4">
                        <TextBlock Text="{Binding CurrentFileText, StringFormat='File: {0}'}"
                                   Foreground="#6B7280" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- Log lines -->
                    <ListBox x:Name="LogListBox" ItemsSource="{Binding Lines}"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,1" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ============ Tab 4: THÔNG TIN ============ -->
            <TabItem Header="Thông tin" FontSize="13" Padding="14,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20" DataContext="{Binding About}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding ProductName}"
                                   FontSize="20" FontWeight="Bold" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Version, StringFormat='Phiên bản {0}'}"
                                   Foreground="#6B7280" Margin="0,2,0,2" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding Company}"
                                   Foreground="#6B7280" Margin="0,0,0,16" />

                        <Label Grid.Row="3" Content="Đường dẫn cấu hình" />
                        <TextBox Grid.Row="4" Text="{Binding ConfigPath, Mode=OneWay}"
                                 IsReadOnly="True" Background="#F9FAFB" />

                        <Label Grid.Row="5" Content="Đường dẫn log" />
                        <TextBox Grid.Row="6" Text="{Binding LogsPath, Mode=OneWay}"
                                 IsReadOnly="True" Background="#F9FAFB" />

                        <Label Grid.Row="7" Content="Hệ điều hành" />
                        <TextBox Grid.Row="8" Text="{Binding OsVersion, Mode=OneWay}"
                                 IsReadOnly="True" Background="#F9FAFB" />

                        <Label Grid.Row="9" Content=".NET runtime" />
                        <TextBox Grid.Row="10" Text="{Binding DotnetVersion, Mode=OneWay}"
                                 IsReadOnly="True" Background="#F9FAFB" />

                        <StackPanel Grid.Row="11" Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="📂 Mở thư mục cấu hình"
                                    Command="{Binding OpenConfigFolderCommand}"
                                    MinWidth="200" Height="32" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="📦 Xuất diagnostics .zip"
                                    Command="{Binding ExportDiagnosticBundleCommand}"
                                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                                    MinWidth="220" Height="32" Padding="12,4" BorderThickness="0" />
                        </StackPanel>

                        <TextBlock Grid.Row="12" Text="{Binding ExportMessage}"
                                   Foreground="{Binding ExportMessageColor}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
